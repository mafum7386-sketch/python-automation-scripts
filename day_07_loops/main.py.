# اليوم 7: التكرار على البيانات For Loops
# =========================================================

orders = [
    {"id": 101, "item": "Laptop", "price": 800, "status": "completed"},
    {"id": 102, "item": "Phone", "price": 500, "status": "pending"},
    {"id": 103, "item": "Headphones", "price": 100, "status": "pending"},
    {"id": 104, "item": "Keyboard", "price": 50, "status": "completed"}
]

print("--- الطلبات المعلقة فقط ---")
for order in orders:
    if order["status"] == "pending":
        print(f"طلب رقم {order['id']}: {order['item']} ({order['price']}$)")

# حساب المجموع والمتوسط
total_sales = 0
for order in orders:
    total_sales += order["price"]

avg_price = total_sales / len(orders)

print("\n--- النتيجة الرقمية ---")
print("إجمالي المبيعات:", total_sales, "$")
print("متوسط القيمة:", avg_price, "$")
